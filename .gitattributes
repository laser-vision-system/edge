# Defaults to using LF.
* text=auto eol=lf

.git* text eol=lf
*.lock text eol=lf
*.toml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.dockerignore eol=lf
LICENSE text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.bpk -text -diff

# Mark Cargo.lock as generated so it is collapsed in PRs.
Cargo.lock linguist-generated=true
